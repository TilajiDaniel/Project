<Page x:Class="NutriTrackWPF.FoodsWpf"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NutriTrackWPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FoodsWpf">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Food Management" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,20" VerticalAlignment="Center">
            <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
            <TextBox x:Name="txtFoodName" Width="60" Height="28" Margin="0,0,10,0" Padding="2" VerticalContentAlignment="Center"/>

            <TextBlock Text="Category ID:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
            <TextBox x:Name="txtCategoryId" Width="40" Height="28" Margin="0,0,10,0" Padding="2" VerticalContentAlignment="Center"/>

            <TextBlock Text="Kcal/100g:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
            <TextBox x:Name="txtCalories" Width="50" Height="28" Margin="0,0,10,0" Padding="2" VerticalContentAlignment="Center"/>

            <TextBlock Text="Protein (g):" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
            <TextBox x:Name="txtProtein" Width="50" Height="28" Margin="0,0,10,0" Padding="2" VerticalContentAlignment="Center"/>

            <TextBlock Text="Carbs (g):" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
            <TextBox x:Name="txtCarbs" Width="50" Height="28" Margin="0,0,10,0" Padding="2" VerticalContentAlignment="Center"/>

            <TextBlock Text="Fat (g):" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
            <TextBox x:Name="txtFat" Width="50" Height="28" Margin="0,0,15,0" Padding="2" VerticalContentAlignment="Center"/>

            <Button x:Name="BtnAddFood" Content="New Food" Padding="15,5" Margin="0,0,15,0" Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAddFood_Click"/>
            <Button x:Name="BtnDeleteFood" Content="Delete" Padding="15,5" Background="#C0392B" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnDeleteFood_Click" Margin="5,0,0,0"/>
        </WrapPanel>

        <DataGrid x:Name="FoodsGrid" Grid.Row="2" AutoGenerateColumns="False" 
                  Background="White" RowBackground="White" AlternatingRowBackground="#F8F9F9"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7E9"
                  BorderThickness="1" BorderBrush="#BDC3C7" CanUserAddRows="False"
                  RowEditEnding="FoodsGrid_RowEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding FoodId}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Category ID" Binding="{Binding CategoryId}" Width="100"/>
                <DataGridTextColumn Header="Calories /100g" Binding="{Binding CaloriesPer100g}" Width="100"/>
                <DataGridTextColumn Header="Protein (g)" Binding="{Binding ProteinPer100g}" Width="90"/>
                <DataGridTextColumn Header="Carbs (g)" Binding="{Binding CarbsPer100g}" Width="100"/>
                <DataGridTextColumn Header="Fat (g)" Binding="{Binding FatPer100g}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>